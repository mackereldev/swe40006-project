# Determines how Docker images are built and run:
#   development: use development server and support watching / hot-reloading
#   production: build the respective application and run with node / preview with vite
# Also determines how each application is configured internally
ENV=development

# Determines how the application behaves and interprets other environment variables
NODE_ENV=development

# The PostgreSQL connection details, which determine how the database is created and connected to
POSTGRES_USER=postgres
POSTGRES_PASSWORD=pass
POSTGRES_DB=db

# The host port mapped to the backend container's server
BACKEND_PORT=5000

# The host port mapped to the frontend container's server
FRONTEND_PORT=4173
